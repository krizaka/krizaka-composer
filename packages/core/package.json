{
  "name": "@krizaka/composer",
  "version": "0.1.0",
  "description": "Krizaka Composer: the visual page editor of the Krizaka family and its document format (a fork of Puck)",
  "author": "Krizaka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krizaka/krizaka-composer.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/krizaka/krizaka-composer/issues",
  "homepage": "https://github.com/krizaka/krizaka-composer#readme",
  "keywords": [
    "puck",
    "visual",
    "editor",
    "react",
    "drag and drop",
    "dnd",
    "page",
    "website",
    "builder",
    "headless",
    "cms",
    "low-code",
    "no-code",
    "javascript",
    "typescript",
    "WYSIWYG"
  ],
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/rsc.d.ts",
        "import": "./dist/rsc.mjs",
        "require": "./dist/rsc.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    },
    "./rsc": {
      "types": "./dist/rsc.d.ts",
      "import": "./dist/rsc.mjs",
      "require": "./dist/rsc.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.mjs",
      "require": "./dist/internal.js"
    },
    "./puck.css": "./dist/index.css",
    "./dist/index.css": "./dist/index.css",
    "./package.json": "./package.json",
    "./document": {
      "types": "./dist/document.d.ts",
      "import": "./dist/document.mjs",
      "require": "./dist/document.js"
    },
    "./no-external.css": "./dist/no-external.css"
  },
  "typesVersions": {
    "*": {
      "rsc": [
        "./dist/rsc.js"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint \"**/*.ts*\"",
    "build": "rm -rf dist && tsup bundle/index.ts bundle/rsc.tsx bundle/no-external.ts bundle/internal.ts bundle/document.ts",
    "test": "jest",
    "prepare": "cp ../../README.md ../../LICENSE ../../NOTICE . && pnpm build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "devDependencies": {
    "@juggle/resize-observer": "^3.4.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/deep-diff": "^1.0.3",
    "@types/flat": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/object-hash": "^3.0.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "css-box-model": "^1.2.1",
    "esbuild": "^0.25.11",
    "eslint": "^9.0.0",
    "eslint-config-custom": "workspace:*",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "lucide-react": "^0.468.0",
    "postcss": "^8.5.6",
    "postcss-modules": "^6.0.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsconfig": "workspace:*",
    "tsup": "^8.2.4",
    "tsup-config": "workspace:*",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.4.0",
    "@dnd-kit/dom": "0.4.0",
    "@dnd-kit/geometry": "0.4.0",
    "@dnd-kit/helpers": "0.4.0",
    "@dnd-kit/react": "0.4.0",
    "@dnd-kit/state": "0.4.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-virtual": "^3.13.9",
    "classnames": "^2.5.1",
    "deep-diff": "^1.0.2",
    "fast-equals": "5.2.2",
    "flat": "^5.0.2",
    "object-hash": "^3.0.0",
    "react-hotkeys-hook": "^4.6.1",
    "use-debounce": "^9.0.4",
    "zod": "^4.1.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
